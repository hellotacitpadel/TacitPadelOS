  "Revenue (IDR)": {
   "id": "suqk",
   "name": "Revenue (IDR)",
   "description": "Incoming-only. Sums the linked Sale's Tacit Net Sales (IDR); falls back to Price (IDR) when no Sale is linked. Locked to 0 on Outgoing rows. Part of the + / - (IDR) Revenue/Cost rebuild, 4 Jul 2026 \u2014 see Pre-Flight Artifact.",
   "type": "formula",
   "formula": {
    "expression": "/* Loans are financing, not revenue \u2014 any row tagged \"Loan\" is excluded from the P&L entirely (tracked separately in the Loans & Deferred app) */\nif(not empty(prop(\"Budget Category\")) and prop(\"Budget Category\").includes(\"Loan\"), 0,\n  if(prop(\"In/Out\") != \"Incoming\", 0,\n    if(prop(\"Sales\").length() == 0,\n      if(empty(prop(\"Price (IDR)\")), 0, prop(\"Price (IDR)\")),\n      prop(\"Sales\").map(current.prop(\"Tacit Net Sales (IDR)\")).sum()\n    )\n  )\n)"
   }
  },
