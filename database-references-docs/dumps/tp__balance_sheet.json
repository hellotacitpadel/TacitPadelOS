  "Min. Access": {
   "id": "%3A%3E~%5D",
   "name": "Min. Access",
   "description": "Minimum access level inferred from Can Edit/Can Comment/Can View",
   "type": "formula",
   "formula": {
    "expression": "lets(\n  /* Combine all people from edit, comment, and view permissions */\n  allPeople, concat(\n    prop(\"Can Edit\"),\n    prop(\"Can Comment\"),\n    prop(\"Can View\")\n  ).map(current.name()),\n  /* Check for access levels in priority order */\n  ifs(\n    allPeople.includes(\"Team\"), \"Team\",\n    allPeople.includes(\"Leadership\"), \"Leadership\",\n    allPeople.includes(\"Owners\"), \"Owners\",\n    \"Admin\"\n  )\n)"
   }
