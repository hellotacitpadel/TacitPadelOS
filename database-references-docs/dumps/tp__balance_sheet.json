   "description": "Sale Status + Cancelled By from linked Sale. Shows richer cancellation context (e.g. 'Late Cancellation (Student)'). Empty if no Sale linked.",
   "type": "formula",
   "formula": {
    "expression": "if(empty(prop(\"Sales\")), \"\",\n  lets(\n    /* Sale Status and Cancelled By from linked Sale */\n    status, prop(\"Sales\").first().prop(\"Sale Status\"),\n    by, prop(\"Sales\").first().prop(\"Cancelled By\"),\n    if(empty(status), \"\",\n      if(empty(by), status, status + \" (\" + by + \")\")\n    )\n  )\n)"
   }
